{
  "buildCommand": "node scripts/build-config.js",
  "outputDirectory": ".",
  "installCommand": "echo skip",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/js/generated/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
