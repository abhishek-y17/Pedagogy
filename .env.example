# Copy to .env.local (gitignored). Same names are set on Vercel
# (Project -> Settings -> Environment Variables).
# The anon key is public by design (RLS + RPC-only access is the protection).
# NEVER put the service_role key or DB password here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Optional. Public origin of this site (defaults to https://expo.pedagogyedn.ae).
# The single source for any absolute URL (canonical/OG). Do NOT point it at the main site.
# SITE_URL=https://expo.pedagogyedn.ae
